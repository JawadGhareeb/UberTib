{
  "expo": {
    "name": "UperTib",
    "slug": "UberTib",
    "scheme": "UberTib",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/shared/assets/icon.jpg",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./src/shared/assets/icon.jpg",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "يسمح UperTib باختيار الصور التي تحددها للملف الشخصي أو المرفقات الطبية.",
          "cameraPermission": "يسمح UperTib باستخدام الكاميرا لالتقاط صورة شخصية أو صورة لمرفق طبي عندما تطلب ذلك."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يسمح UperTib باستخدام موقع جهازك لتحديد منطقتك الحالية عندما تطلب ذلك."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "يسمح أوبرطب بفتح تقويم الجهاز لإضافة مواعيدك بعد موافقتك.",
          "writeOnlyCalendarPermission": "يسمح أوبرطب بإضافة موعد إلى التقويم بعد مراجعتك وحفظك للحدث.",
          "writeOnlyAccess": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.upertib.patient",
      "adaptiveIcon": {
        "foregroundImage": "./src/shared/assets/adaptive-foreground.png",
        "backgroundColor": "#111111"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "lang": "ar",
      "dir": "rtl",
      "favicon": "./src/shared/assets/icon.jpg"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d51957d-51b2-4626-922b-baaca411e359"
      }
    },
    "owner": "jawad_ghareeb",
    "icon": "./src/shared/assets/icon.jpg"
  }
}
