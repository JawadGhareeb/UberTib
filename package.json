{
  "name": "upertib-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run typecheck",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build": "npm run lint && npm run typecheck && npm run build:android && npm run build:ios"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "expo": "~57.0.30",
    "expo-blur": "~57.0.3",
    "expo-calendar": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "heroui-native": "^1.0.10",
    "lucide-react-native": "^1.60.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.12.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.7.3",
    "typescript": "~6.0.3"
  }
}
