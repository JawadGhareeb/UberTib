{
  "name": "upertib-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run theme:check && npm run brand:check && npm run typography:check && npm run ui:check && npm run routes:check && npm run care-ui:check && npm run booking-ui:check && npm run backend-contract:check && npm run profile-ui:check && npm run splash:check && npm run care-mock:check && npm run assessment-ui:check && npm run location-ui:check && npm run patient-copy:check && npm run assessment-pen:check && npm run discovery-detail:check && npm run inline-facts:check",
    "brand:check": "node scripts/check-brand-theme.mjs",
    "theme:sync": "node scripts/sync-brand-theme.mjs --write",
    "theme:check": "node scripts/sync-brand-theme.mjs --check",
    "uniwind:theme:sync": "node scripts/generate-uniwind-theme.mjs --write",
    "uniwind:theme:check": "node scripts/generate-uniwind-theme.mjs --check",
    "typography:check": "node scripts/check-typography.mjs",
    "brand:legacy-audit": "node scripts/audit-legacy-primary.mjs",
    "ui:check": "node scripts/check-ui-components.mjs",
    "routes:check": "node scripts/audit-routes.mjs",
    "care-ui:check": "node scripts/check-care-visual-contract.mjs",
    "booking-ui:check": "node scripts/check-booking-discovery-ui.mjs",
    "backend-contract:check": "node scripts/check-patient-v5-contract.mjs",
    "profile-ui:check": "node scripts/check-profile-pen-reference.mjs",
    "splash:check": "node scripts/check-splash-assets.mjs",
    "care-mock:check": "node scripts/check-case-mock-journeys.mjs",
    "assessment-ui:check": "node scripts/check-assessment-confirmations.mjs",
    "location-ui:check": "node scripts/check-location-picker.mjs",
    "patient-copy:check": "node scripts/check-patient-copy.mjs",
    "assessment-pen:check": "node scripts/check-assessment-pen-media-review.mjs",
    "discovery-detail:check": "node scripts/check-discovery-detail-pen-routes.mjs",
    "inline-facts:check": "node scripts/check-inline-fact-dividers.mjs",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build": "npm run lint && npm run typecheck && npm run uniwind:theme:check && npm run build:android && npm run build:ios",
    "provider-ui:check": "node scripts/check-provider-presentation-ui.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "expo": "~57.0.30",
    "expo-blur": "~57.0.3",
    "expo-calendar": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.21",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "heroui-native": "^1.0.10",
    "lucide-react-native": "^1.60.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "uniwind": "^1.12.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^57.0.2",
    "prettier": "^3.7.3",
    "typescript": "~6.0.3"
  }
}
